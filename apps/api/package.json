    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.0",
    "argon2": "^0.44.0",
    "class-validator": "^0.14.3",
    "class-transformer": "^0.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
