generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ClubSettings {
  id        String   @id @default("club")
  name      String   @default("Страйд")
  timezone  String   @default("Europe/Moscow")
  currency  String   @default("RUB")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
}

enum Role {
  OWNER
  ADMIN
  RECEPTION
  TRAINER
  CLIENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  name            String
  passwordHash    String
  status          UserStatus      @default(ACTIVE)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  roles           UserRole[]
  sessions        AuthSession[]
  tokens          OneTimeToken[]
  consents        ConsentRecord[]
  client          ClientProfile?
  trainer         TrainerProfile?
}

model UserRole {
  userId String @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  csrfHash   String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OneTimeToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model ConsentRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  documentType    String
  documentVersion String
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model StaffInvite {
  clientId   String?   @db.Uuid
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  name       String
  roles      Role[]
  invitedBy  String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

model ClientProfile {
  memberships   Membership[]
  orders        Order[]
  email         String?
  notes         ClientNote[]
  trainers      TrainerClient[]
  id            String          @id @default(uuid()) @db.Uuid
  userId        String?         @unique @db.Uuid
  name          String
  phone         String?
  status        String          @default("ACTIVE")
  visitsBlocked Boolean         @default(false)
  joinedAt      DateTime        @default(now())
  archivedAt    DateTime?
  version       Int             @default(1)
  user          User?           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([phone])
}

model TrainerProfile {
  sessions     ScheduledSession[]
  occupancies  TrainerOccupancy[]
  planVersions MembershipPlanVersion[] @relation("PlanTrainers")
  specialties  String[]                @default([])
  workingHours Json                    @default("[]")
  clients      TrainerClient[]
  absences     TrainerAbsence[]
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @unique @db.Uuid
  slug         String                  @unique
  bio          String                  @default("")
  active       Boolean                 @default(true)
  published    Boolean                 @default(false)
  archivedAt   DateTime?
  version      Int                     @default(1)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  dedupKey    String    @unique
  payload     String
  status      String    @default("PENDING")
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  changes    Json     @default("{}")
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model RateBucket {
  key    String
  window DateTime
  count  Int      @default(1)

  @@id([key, window])
}

model ClientNote {
  id        String        @id @default(uuid()) @db.Uuid
  clientId  String        @db.Uuid
  actorId   String        @db.Uuid
  text      String
  createdAt DateTime      @default(now())
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Restrict)
}

model TrainerClient {
  trainerId String         @db.Uuid
  clientId  String         @db.Uuid
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  client    ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@id([trainerId, clientId])
}

model Hall {
  sessions     ScheduledSession[]
  occupancies  HallOccupancy[]
  planVersions MembershipPlanVersion[] @relation("PlanHalls")
  id           String                  @id @default(uuid()) @db.Uuid
  name         String
  slug         String                  @unique
  description  String                  @default("")
  capacity     Int
  equipment    String[]                @default([])
  imageUrl     String?
  published    Boolean                 @default(false)
  archivedAt   DateTime?
  version      Int                     @default(1)
  closures     HallClosure[]
}

model HallClosure {
  cancelledAt DateTime?
  occupancy   HallOccupancy?
  id          String         @id @default(uuid()) @db.Uuid
  hallId      String         @db.Uuid
  startAt     DateTime
  endAt       DateTime
  reason      String
  hall        Hall           @relation(fields: [hallId], references: [id], onDelete: Restrict)

  @@index([hallId, startAt, endAt])
}

model TrainerAbsence {
  cancelledAt DateTime?
  occupancy   TrainerOccupancy?
  id          String            @id @default(uuid()) @db.Uuid
  trainerId   String            @db.Uuid
  startAt     DateTime
  endAt       DateTime
  reason      String
  trainer     TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([trainerId, startAt, endAt])
}

model WorkoutType {
  sessions        ScheduledSession[]
  planVersions    MembershipPlanVersion[] @relation("PlanWorkouts")
  id              String                  @id @default(uuid()) @db.Uuid
  name            String
  slug            String                  @unique
  description     String                  @default("")
  category        String
  level           String                  @default("ALL")
  durationMinutes Int                     @default(60)
  format          String                  @default("GROUP")
  capacity        Int                     @default(12)
  equipment       String[]                @default([])
  imageUrl        String?
  published       Boolean                 @default(false)
  archivedAt      DateTime?
  version         Int                     @default(1)
}

model SessionSeries {
  id         String             @id @default(uuid()) @db.Uuid
  definition Json
  version    Int                @default(1)
  createdBy  String             @db.Uuid
  createdAt  DateTime           @default(now())
  sessions   ScheduledSession[]
}

model ScheduledSession {
  id               String            @id @default(uuid()) @db.Uuid
  seriesId         String?           @db.Uuid
  occurrenceDate   String?
  workoutId        String            @db.Uuid
  trainerId        String            @db.Uuid
  hallId           String            @db.Uuid
  startAt          DateTime
  endAt            DateTime
  capacity         Int
  status           String            @default("DRAFT")
  policySnapshot   Json
  version          Int               @default(1)
  cancelledReason  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  series           SessionSeries?    @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  workout          WorkoutType       @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  trainer          TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  hall             Hall              @relation(fields: [hallId], references: [id], onDelete: Restrict)
  hallOccupancy    HallOccupancy?
  trainerOccupancy TrainerOccupancy?

  @@unique([seriesId, occurrenceDate])
  @@index([status, startAt])
  @@index([trainerId, startAt])
  @@index([hallId, startAt])
}

model HallOccupancy {
  id        String            @id @default(uuid()) @db.Uuid
  hallId    String            @db.Uuid
  sessionId String?           @unique @db.Uuid
  closureId String?           @unique @db.Uuid
  startAt   DateTime
  endAt     DateTime
  active    Boolean           @default(true)
  hall      Hall              @relation(fields: [hallId], references: [id], onDelete: Restrict)
  session   ScheduledSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  closure   HallClosure?      @relation(fields: [closureId], references: [id], onDelete: Restrict)

  @@index([hallId, startAt, endAt])
}

model TrainerOccupancy {
  id        String            @id @default(uuid()) @db.Uuid
  trainerId String            @db.Uuid
  sessionId String?           @unique @db.Uuid
  absenceId String?           @unique @db.Uuid
  startAt   DateTime
  endAt     DateTime
  active    Boolean           @default(true)
  trainer   TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  session   ScheduledSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  absence   TrainerAbsence?   @relation(fields: [absenceId], references: [id], onDelete: Restrict)

  @@index([trainerId, startAt, endAt])
}

model MembershipPlan {
  id         String                  @id @default(uuid()) @db.Uuid
  name       String
  slug       String                  @unique
  published  Boolean                 @default(false)
  archivedAt DateTime?
  version    Int                     @default(1)
  versions   MembershipPlanVersion[]
}

model MembershipPlanVersion {
  id                   String           @id @default(uuid()) @db.Uuid
  planId               String           @db.Uuid
  number               Int
  title                String
  description          String
  priceMinor           Int
  durationDays         Int
  visitLimit           Int?
  freezeQuotaDays      Int              @default(0)
  activationWindowDays Int              @default(30)
  weekdays             Int[]            @default([0, 1, 2, 3, 4, 5, 6])
  startMinute          Int              @default(0)
  endMinute            Int              @default(1440)
  createdAt            DateTime         @default(now())
  plan                 MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  workouts             WorkoutType[]    @relation("PlanWorkouts")
  trainers             TrainerProfile[] @relation("PlanTrainers")
  halls                Hall[]           @relation("PlanHalls")
  memberships          Membership[]
  orders               Order[]

  @@unique([planId, number])
}

model Order {
  id              String                @id @default(uuid()) @db.Uuid
  clientId        String                @db.Uuid
  planVersionId   String                @db.Uuid
  totalMinor      Int
  currency        String                @default("RUB")
  status          String                @default("PENDING")
  activationDate  DateTime
  productSnapshot Json
  expiresAt       DateTime
  paidAt          DateTime?
  createdAt       DateTime              @default(now())
  createdBy       String                @db.Uuid
  client          ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planVersion     MembershipPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  membership      Membership?

  @@index([clientId, createdAt])
}

model Membership {
  id            String                @id @default(uuid()) @db.Uuid
  clientId      String                @db.Uuid
  planVersionId String                @db.Uuid
  orderId       String                @unique @db.Uuid
  startAt       DateTime
  endAt         DateTime
  cancelledAt   DateTime?
  termsSnapshot Json
  available     Int                   @default(0)
  reserved      Int                   @default(0)
  consumed      Int                   @default(0)
  version       Int                   @default(1)
  createdAt     DateTime              @default(now())
  client        ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planVersion   MembershipPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ledger        MembershipLedger[]
  freezes       MembershipFreeze[]

  @@index([clientId, endAt])
}

model MembershipLedger {
  id             String     @id @default(uuid()) @db.Uuid
  membershipId   String     @db.Uuid
  bookingId      String?    @db.Uuid
  eventKey       String     @unique
  kind           String
  availableDelta Int
  reservedDelta  Int
  consumedDelta  Int
  reason         String?
  actorId        String?    @db.Uuid
  createdAt      DateTime   @default(now())
  membership     Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, createdAt])
}

model MembershipFreeze {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @db.Uuid
  startAt      DateTime
  endAt        DateTime
  days         Int
  status       String     @default("ACTIVE")
  reason       String?
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, startAt, endAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  route       String
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  @@unique([actorId, route, key])
}
