generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ClubSettings {
  version Int @default(1)
  id        String   @id @default("club")
  name      String   @default("Страйд")
  timezone  String   @default("Europe/Moscow")
  currency  String   @default("RUB")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
}

enum Role {
  OWNER
  ADMIN
  RECEPTION
  TRAINER
  CLIENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  notificationPreferences Json @default("{}")
  notifications Notification[]
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  name            String
  passwordHash    String
  status          UserStatus      @default(ACTIVE)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  roles           UserRole[]
  sessions        AuthSession[]
  tokens          OneTimeToken[]
  consents        ConsentRecord[]
  client          ClientProfile?
  trainer         TrainerProfile?
}

model UserRole {
  userId String @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  csrfHash   String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OneTimeToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model ConsentRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  documentType    String
  documentVersion String
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model StaffInvite {
  clientId   String?   @db.Uuid
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  name       String
  roles      Role[]
  invitedBy  String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

model ClientProfile {
  programAssignments ProgramAssignment[]
  bookings Booking[]
  occupancies ClientOccupancy[]
  memberships   Membership[]
  orders        Order[]
  email         String?
  notes         ClientNote[]
  trainers      TrainerClient[]
  id            String          @id @default(uuid()) @db.Uuid
  userId        String?         @unique @db.Uuid
  name          String
  phone         String?
  status        String          @default("ACTIVE")
  visitsBlocked Boolean         @default(false)
  joinedAt      DateTime        @default(now())
  archivedAt    DateTime?
  version       Int             @default(1)
  user          User?           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([phone])
}

model TrainerProfile {
  programs TrainingProgram[]
  programAssignments ProgramAssignment[]
  sessions     ScheduledSession[]
  occupancies  TrainerOccupancy[]
  planVersions MembershipPlanVersion[] @relation("PlanTrainers")
  specialties  String[]                @default([])
  workingHours Json                    @default("[]")
  clients      TrainerClient[]
  absences     TrainerAbsence[]
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @unique @db.Uuid
  slug         String                  @unique
  bio          String                  @default("")
  active       Boolean                 @default(true)
  published    Boolean                 @default(false)
  archivedAt   DateTime?
  version      Int                     @default(1)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  dedupKey    String    @unique
  payload     String
  status      String    @default("PENDING")
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt])
}

model AuditLog {
  requestId String?
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  changes    Json     @default("{}")
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model RateBucket {
  key    String
  window DateTime
  count  Int      @default(1)

  @@id([key, window])
}

model ClientNote {
  id        String        @id @default(uuid()) @db.Uuid
  clientId  String        @db.Uuid
  actorId   String        @db.Uuid
  text      String
  createdAt DateTime      @default(now())
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Restrict)
}

model TrainerClient {
  trainerId String         @db.Uuid
  clientId  String         @db.Uuid
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  client    ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@id([trainerId, clientId])
}

model Hall {
  sessions     ScheduledSession[]
  occupancies  HallOccupancy[]
  planVersions MembershipPlanVersion[] @relation("PlanHalls")
  id           String                  @id @default(uuid()) @db.Uuid
  name         String
  slug         String                  @unique
  description  String                  @default("")
  capacity     Int
  equipment    String[]                @default([])
  imageUrl     String?
  published    Boolean                 @default(false)
  archivedAt   DateTime?
  version      Int                     @default(1)
  closures     HallClosure[]
}

model HallClosure {
  cancelledAt DateTime?
  occupancy   HallOccupancy?
  id          String         @id @default(uuid()) @db.Uuid
  hallId      String         @db.Uuid
  startAt     DateTime
  endAt       DateTime
  reason      String
  hall        Hall           @relation(fields: [hallId], references: [id], onDelete: Restrict)

  @@index([hallId, startAt, endAt])
}

model TrainerAbsence {
  cancelledAt DateTime?
  occupancy   TrainerOccupancy?
  id          String            @id @default(uuid()) @db.Uuid
  trainerId   String            @db.Uuid
  startAt     DateTime
  endAt       DateTime
  reason      String
  trainer     TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([trainerId, startAt, endAt])
}

model WorkoutType {
  sessions        ScheduledSession[]
  planVersions    MembershipPlanVersion[] @relation("PlanWorkouts")
  id              String                  @id @default(uuid()) @db.Uuid
  name            String
  slug            String                  @unique
  description     String                  @default("")
  category        String
  level           String                  @default("ALL")
  durationMinutes Int                     @default(60)
  format          String                  @default("GROUP")
  capacity        Int                     @default(12)
  equipment       String[]                @default([])
  imageUrl        String?
  published       Boolean                 @default(false)
  archivedAt      DateTime?
  version         Int                     @default(1)
}

model SessionSeries {
  id         String             @id @default(uuid()) @db.Uuid
  definition Json
  version    Int                @default(1)
  createdBy  String             @db.Uuid
  createdAt  DateTime           @default(now())
  sessions   ScheduledSession[]
}

model ScheduledSession {
  bookings Booking[]
  id               String            @id @default(uuid()) @db.Uuid
  seriesId         String?           @db.Uuid
  occurrenceDate   String?
  workoutId        String            @db.Uuid
  trainerId        String            @db.Uuid
  hallId           String            @db.Uuid
  startAt          DateTime
  endAt            DateTime
  capacity         Int
  status           String            @default("DRAFT")
  policySnapshot   Json
  version          Int               @default(1)
  cancelledReason  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  series           SessionSeries?    @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  workout          WorkoutType       @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  trainer          TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  hall             Hall              @relation(fields: [hallId], references: [id], onDelete: Restrict)
  hallOccupancy    HallOccupancy?
  trainerOccupancy TrainerOccupancy?

  @@unique([seriesId, occurrenceDate])
  @@index([status, startAt])
  @@index([trainerId, startAt])
  @@index([hallId, startAt])
}

model HallOccupancy {
  id        String            @id @default(uuid()) @db.Uuid
  hallId    String            @db.Uuid
  sessionId String?           @unique @db.Uuid
  closureId String?           @unique @db.Uuid
  startAt   DateTime
  endAt     DateTime
  active    Boolean           @default(true)
  hall      Hall              @relation(fields: [hallId], references: [id], onDelete: Restrict)
  session   ScheduledSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  closure   HallClosure?      @relation(fields: [closureId], references: [id], onDelete: Restrict)

  @@index([hallId, startAt, endAt])
}

model TrainerOccupancy {
  id        String            @id @default(uuid()) @db.Uuid
  trainerId String            @db.Uuid
  sessionId String?           @unique @db.Uuid
  absenceId String?           @unique @db.Uuid
  startAt   DateTime
  endAt     DateTime
  active    Boolean           @default(true)
  trainer   TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  session   ScheduledSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  absence   TrainerAbsence?   @relation(fields: [absenceId], references: [id], onDelete: Restrict)

  @@index([trainerId, startAt, endAt])
}

model MembershipPlan {
  id         String                  @id @default(uuid()) @db.Uuid
  name       String
  slug       String                  @unique
  published  Boolean                 @default(false)
  archivedAt DateTime?
  version    Int                     @default(1)
  versions   MembershipPlanVersion[]
}

model MembershipPlanVersion {
  id                   String           @id @default(uuid()) @db.Uuid
  planId               String           @db.Uuid
  number               Int
  title                String
  description          String
  priceMinor           Int
  durationDays         Int
  visitLimit           Int?
  freezeQuotaDays      Int              @default(0)
  activationWindowDays Int              @default(30)
  weekdays             Int[]            @default([0, 1, 2, 3, 4, 5, 6])
  startMinute          Int              @default(0)
  endMinute            Int              @default(1440)
  createdAt            DateTime         @default(now())
  plan                 MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  workouts             WorkoutType[]    @relation("PlanWorkouts")
  trainers             TrainerProfile[] @relation("PlanTrainers")
  halls                Hall[]           @relation("PlanHalls")
  memberships          Membership[]
  orders               Order[]

  @@unique([planId, number])
}

model Order {
  id              String                @id @default(uuid()) @db.Uuid
  clientId        String                @db.Uuid
  planVersionId   String                @db.Uuid
  totalMinor      Int
  currency        String                @default("RUB")
  status          String                @default("PENDING")
  activationDate  DateTime
  productSnapshot Json
  expiresAt       DateTime
  paidAt          DateTime?
  createdAt       DateTime              @default(now())
  createdBy       String                @db.Uuid
  client          ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planVersion     MembershipPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  membership      Membership?
  payments        PaymentAttempt[]

  @@index([clientId, createdAt])
}

model Membership {
  bookings Booking[]
  id            String                @id @default(uuid()) @db.Uuid
  clientId      String                @db.Uuid
  planVersionId String                @db.Uuid
  orderId       String                @unique @db.Uuid
  startAt       DateTime
  endAt         DateTime
  cancelledAt   DateTime?
  refundHold    Boolean               @default(false)
  termsSnapshot Json
  available     Int                   @default(0)
  reserved      Int                   @default(0)
  consumed      Int                   @default(0)
  version       Int                   @default(1)
  createdAt     DateTime              @default(now())
  client        ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planVersion   MembershipPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ledger        MembershipLedger[]
  freezes       MembershipFreeze[]

  @@index([clientId, endAt])
}

model MembershipLedger {
  id             String     @id @default(uuid()) @db.Uuid
  membershipId   String     @db.Uuid
  bookingId      String?    @db.Uuid
  eventKey       String     @unique
  kind           String
  availableDelta Int
  reservedDelta  Int
  consumedDelta  Int
  reason         String?
  actorId        String?    @db.Uuid
  createdAt      DateTime   @default(now())
  membership     Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, createdAt])
}

model MembershipFreeze {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @db.Uuid
  startAt      DateTime
  endAt        DateTime
  days         Int
  status       String     @default("ACTIVE")
  reason       String?
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, startAt, endAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  route       String
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  @@unique([actorId, route, key])
}

model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  method String
  provider String @default("simulator")
  providerPaymentId String @unique @default(uuid())
  status String @default("PROCESSING")
  amountMinor Int
  maskedLast4 String?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  nextCheckAt DateTime @default(now())
  checkCount Int @default(0)
  internalOutcome String @default("SUCCESS")
  failureCode String?
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  events PaymentEvent[]
  refunds Refund[]
  confirmation PaymentConfirmation?
  @@index([status,nextCheckAt])
  @@index([orderId,createdAt])
}
model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String
  providerEventId String
  paymentId String @db.Uuid
  eventType String
  receivedAt DateTime @default(now())
  processedAt DateTime @default(now())
  payment PaymentAttempt @relation(fields:[paymentId],references:[id],onDelete:Restrict)
  @@unique([provider,providerEventId])
}
model Refund {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid
  amountMinor Int
  status String @default("PROCESSING")
  reason String
  entitlementAction String
  requestedBy String @db.Uuid
  completedAt DateTime?
  createdAt DateTime @default(now())
  nextCheckAt DateTime @default(now())
  checkCount Int @default(0)
  internalOutcome String @default("SUCCESS")
  providerRefundId String @unique @default(uuid())
  payment PaymentAttempt @relation(fields:[paymentId],references:[id],onDelete:Restrict)
  @@index([status,nextCheckAt])
  @@index([paymentId,status])
}
model PaymentConfirmation {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @unique @db.Uuid
  reference String @unique
  issuedAt DateTime @default(now())
  immutableSnapshot Json
  payment PaymentAttempt @relation(fields:[paymentId],references:[id],onDelete:Restrict)
}

model Booking {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  sessionId String @db.Uuid
  membershipId String @db.Uuid
  status String
  balanceState String @default("NONE")
  version Int @default(1)
  queuedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reason String?
  attendanceAt DateTime?
  client ClientProfile @relation(fields:[clientId],references:[id],onDelete:Restrict)
  session ScheduledSession @relation(fields:[sessionId],references:[id],onDelete:Restrict)
  membership Membership @relation(fields:[membershipId],references:[id],onDelete:Restrict)
  occupancy ClientOccupancy?
  events BookingEvent[]
  @@unique([clientId,sessionId])
  @@index([sessionId,status,queuedAt,id])
  @@index([membershipId,status])
  @@index([clientId,createdAt])
}
model BookingEvent {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid
  eventKey String @unique
  fromStatus String?
  toStatus String
  actorId String? @db.Uuid
  reason String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
}
model ClientOccupancy {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  bookingId String @unique @db.Uuid
  startAt DateTime
  endAt DateTime
  active Boolean @default(true)
  client ClientProfile @relation(fields:[clientId],references:[id],onDelete:Restrict)
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
  @@index([clientId,startAt,endAt])
}
model Notification {
 id String @id @default(uuid()) @db.Uuid
 recipientId String @db.Uuid
 type String
 title String
 text String
 href String
 eventKey String
 createdAt DateTime @default(now())
 readAt DateTime?
 recipient User @relation(fields:[recipientId],references:[id],onDelete:Restrict)
 @@unique([recipientId,eventKey])
 @@index([recipientId,readAt,createdAt])
}

model Lead {
 id String @id @default(uuid()) @db.Uuid
 name String
 phone String
 email String?
 message String
 consentAt DateTime @default(now())
 consentVersion String @default("2026-09")
 status String @default("NEW")
 assignedTo String? @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events LeadEvent[]
 @@index([status,createdAt])
}
model LeadEvent {
 id String @id @default(uuid()) @db.Uuid
 leadId String @db.Uuid
 actorId String? @db.Uuid
 status String
 note String
 createdAt DateTime @default(now())
 lead Lead @relation(fields:[leadId],references:[id],onDelete:Restrict)
}
model ExportJob {
 id String @id @default(uuid()) @db.Uuid
 requestedBy String @db.Uuid
 filters Json
 status String @default("PENDING")
 fileName String?
 rowCount Int?
 createdAt DateTime @default(now())
 completedAt DateTime?
 expiresAt DateTime?
 lockedAt DateTime?
 lastError String?
 @@index([status,createdAt])
}

model Exercise {
 id String @id @default(uuid()) @db.Uuid
 name String
 category String
 equipment String[] @default([])
 instructions String
 metricType String
 imageUrl String?
 archivedAt DateTime?
 version Int @default(1)
 createdAt DateTime @default(now())
 prescriptions ProgramExercise[]
 @@index([name])
}
model TrainingProgram {
 id String @id @default(uuid()) @db.Uuid
 authorTrainerId String @db.Uuid
 title String
 draft Json
 version Int @default(1)
 archivedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 author TrainerProfile @relation(fields:[authorTrainerId],references:[id],onDelete:Restrict)
 versions ProgramVersion[]
 assignments ProgramAssignment[]
}
model ProgramVersion {
 id String @id @default(uuid()) @db.Uuid
 programId String @db.Uuid
 number Int
 title String
 goal String
 level String
 weeks Int
 publishedAt DateTime @default(now())
 program TrainingProgram @relation(fields:[programId],references:[id],onDelete:Restrict)
 days ProgramDay[]
 assignments ProgramAssignment[]
 @@unique([programId,number])
}
model ProgramDay {
 id String @id @default(uuid()) @db.Uuid
 programVersionId String @db.Uuid
 weekNumber Int
 dayIndex Int
 title String
 programVersion ProgramVersion @relation(fields:[programVersionId],references:[id],onDelete:Restrict)
 exercises ProgramExercise[]
 logs ProgramDayLog[]
 @@unique([programVersionId,weekNumber,dayIndex])
}
model ProgramExercise {
 id String @id @default(uuid()) @db.Uuid
 dayId String @db.Uuid
 exerciseId String @db.Uuid
 position Int
 exerciseSnapshot Json
 sets Int
 reps Int?
 durationSeconds Int?
 weightKg Decimal? @db.Decimal(6,2)
 restSeconds Int
 notes String
 day ProgramDay @relation(fields:[dayId],references:[id],onDelete:Restrict)
 exercise Exercise @relation(fields:[exerciseId],references:[id],onDelete:Restrict)
 logs ExerciseSetLog[]
 @@unique([dayId,position])
}
model ProgramAssignment {
 id String @id @default(uuid()) @db.Uuid
 programId String @db.Uuid
 programVersionId String @db.Uuid
 clientId String @db.Uuid
 trainerId String @db.Uuid
 startsOn DateTime
 status String @default("ACTIVE")
 version Int @default(1)
 createdAt DateTime @default(now())
 completedAt DateTime?
 replacedById String? @unique @db.Uuid
 program TrainingProgram @relation(fields:[programId],references:[id],onDelete:Restrict)
 programVersion ProgramVersion @relation(fields:[programVersionId],references:[id],onDelete:Restrict)
 client ClientProfile @relation(fields:[clientId],references:[id],onDelete:Restrict)
 trainer TrainerProfile @relation(fields:[trainerId],references:[id],onDelete:Restrict)
 replacedBy ProgramAssignment? @relation("AssignmentReplacement",fields:[replacedById],references:[id],onDelete:Restrict)
 replaces ProgramAssignment? @relation("AssignmentReplacement")
 logs ProgramDayLog[]
 comments ProgramComment[]
 @@index([clientId,status])
 @@index([trainerId,status])
}
model ProgramDayLog {
 id String @id @default(uuid()) @db.Uuid
 assignmentId String @db.Uuid
 dayId String @db.Uuid
 performedOn DateTime
 completedAt DateTime?
 comment String
 version Int @default(1)
 createdAt DateTime @default(now())
 assignment ProgramAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict)
 day ProgramDay @relation(fields:[dayId],references:[id],onDelete:Restrict)
 sets ExerciseSetLog[]
 revisions ProgramLogRevision[]
 @@unique([assignmentId,dayId])
}
model ExerciseSetLog {
 id String @id @default(uuid()) @db.Uuid
 dayLogId String @db.Uuid
 programExerciseId String @db.Uuid
 setIndex Int
 actualReps Int?
 actualSeconds Int?
 actualWeightKg Decimal? @db.Decimal(6,2)
 dayLog ProgramDayLog @relation(fields:[dayLogId],references:[id],onDelete:Restrict)
 programExercise ProgramExercise @relation(fields:[programExerciseId],references:[id],onDelete:Restrict)
 @@unique([dayLogId,programExerciseId,setIndex])
}
model ProgramLogRevision {
 id String @id @default(uuid()) @db.Uuid
 dayLogId String @db.Uuid
 version Int
 snapshot Json
 createdAt DateTime @default(now())
 dayLog ProgramDayLog @relation(fields:[dayLogId],references:[id],onDelete:Restrict)
 @@unique([dayLogId,version])
}
model ProgramComment {
 id String @id @default(uuid()) @db.Uuid
 assignmentId String @db.Uuid
 authorId String @db.Uuid
 authorName String
 body String
 visibility String @default("SHARED")
 createdAt DateTime @default(now())
 assignment ProgramAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict)
 @@index([assignmentId,createdAt])
}
