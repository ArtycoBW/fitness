{
  "name": "fitness",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --project apps/api/tsconfig.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d postgres mailpit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "typescript-eslint": "^8.57.0",
    "typescript": "5.9.3",
    "prisma": "7.10.0",
    "ts-node": "^10.9.2",
    "vitest": "^4.0.0",
    "dotenv": "^17.0.0"
  }
}
